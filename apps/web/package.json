{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:app": "next dev",
    "build": "pnpm run build:mcp-app && next build --webpack",
    "build:mcp-app": "vite build --config mcp-app/vite.config.ts",
    "build:agents": "for agent in ../../agents/*/; do (cd \"$agent\" && eve build) || exit 1; done",
    "start": "pnpm build:agents && next start",
    "db:migrate": "drizzle-kit push --force",
    "check-types": "tsc-ts --noEmit",
    "test": "pnpm run build:mcp-app && vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/gateway": "4.0.125",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-lang": "1.0.1",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@typesafe-ai/sdk": "^0.7.0",
    "ai": "^7.0.152",
    "drizzle-orm": "^0.45.4",
    "eve": "^0.83.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "portless": {
    "name": "app",
    "script": "dev:app"
  }
}
