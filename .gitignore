.env
.env.*
!.env.example
!.env.*.example
!.env.schema

# Testing
coverage
**/tests/browser/report/
**/tests/browser/test-results/
**/playwright-report/
**/test-results/

# Turbo
.turbo

# eve local dev/build artifacts
.eve/
.output/

# Vercel
.vercel

# Build Outputs
.next/
out/
build
!.agents/skills/build/
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flow local prompt logs
.agents/flow/prompts.txt
prompts.txt
.agents/flow/local/

# Misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
__dev
.agents/eval/evidence/
.worktrees/

