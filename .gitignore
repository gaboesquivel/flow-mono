# Editor local state (template skills under .agents/skills are committed)
.cursor/*
!.cursor/agents/
!.cursor/agents/**
!.cursor/commands/
!.cursor/commands/**
!.cursor/hooks.json
!.cursor/cli.json
!.cursor/environment.json

# Neon Local metadata
