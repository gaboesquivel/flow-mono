# Optional: Vercel AI Gateway for chat and open-ended GenUI generation.
# On Vercel, OIDC authenticates the Gateway with no key; set a key for local development.
AI_GATEWAY_API_KEY=

# Optional: direct Anthropic for /api/chat (see apps/web/lib/ai/resolve-chat-model.ts)
ANTHROPIC_API_KEY=

# Protected Operator MCP and operator chat (required in production for operator surfaces)
OPERATOR_SECRET=

# Eve agent model overrides (Gateway ids; default anthropic/claude-sonnet-5.5)
# EVE_AGENT_MODEL=
# EVE_OPERATOR_MODEL=

# Optional local HTTP chat: extend apps/web/lib/ai/resolve-chat-model.ts with your provider, then:
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2
