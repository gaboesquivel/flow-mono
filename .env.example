# Optional: Vercel AI Gateway for chat and open-ended GenUI generation.
# On Vercel, OIDC authenticates the Gateway with no key; set a key for local development.
AI_GATEWAY_API_KEY=

# Optional: direct Anthropic for /api/chat
ANTHROPIC_API_KEY=

# Protected Operator MCP and /api/chat/operator (required in production for operator surfaces)
OPERATOR_SECRET=

# Eve agent model override
# EVE_AGENT_MODEL=anthropic/claude-sonnet-5.5
